 from megatron.bridge.training.utils.visual_inputs import Qwen2_5_VLVisualInputs
 
 
+CHATML_ASSISTANT_START = "<|im_start|>assistant\n"
+CHATML_ASSISTANT_END = "<|im_end|>"
+
+
+def _build_chatml_assistant_target(input_ids, conversation, tokenizer, pad_token_id):
+    """Build an unshifted target covering complete ChatML assistant turns.
+
+    Tokens supplied by the inference generation prompt remain masked. Every
+    token after the assistant role marker through ``<|im_end|>`` is included,
+    including template-generated thinking boundaries that are not present in
+    the raw assistant content.
+    """
+    assistant_turns = sum(turn["role"] == "assistant" for turn in conversation)
+    if assistant_turns == 0:
+        return None
+
+    start_tokens = tokenizer.encode(CHATML_ASSISTANT_START, add_special_tokens=False)
+    end_tokens = tokenizer.encode(CHATML_ASSISTANT_END, add_special_tokens=False)
+    if not start_tokens or not end_tokens:
+        return None
+
+    target = np.full(input_ids.shape, pad_token_id, dtype=input_ids.dtype)
+    search_start = 0
+    matched_turns = 0
+    while True:
+        _, content_start = find_pattern_indices(input_ids, start_tokens, search_start)
+        if content_start < 0:
+            break
+
+        end_start, turn_end = find_pattern_indices(input_ids, end_tokens, content_start)
+        if end_start < 0:
+            raise ValueError("ChatML assistant start marker has no matching <|im_end|> marker.")
+
+        target[content_start:turn_end] = input_ids[content_start:turn_end]
+        matched_turns += 1
+        search_start = turn_end
+
+    if matched_turns == 0:
+        return None
+    if matched_turns != assistant_turns:
+        raise ValueError(
+            f"Matched {matched_turns} ChatML assistant spans for {assistant_turns} assistant conversation turns."
+        )
+    return target
+
+
